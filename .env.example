# Board Hub 环境变量
# 本地开发可以复制成 .env.local；线上在 Vercel 项目设置里配置

# ---------- 登录鉴权（必填） ----------
# 会话签名密钥：随机长字符串，泄露 = 任何人可伪造登录态
AUTH_SECRET=
# 管理员密码：拥有全部权限（查看/下载/编辑/发布/删除/仓库浏览）
ADMIN_PASSWORD=
# 查看者密码：只能查看与下载（可选，不设则没有查看者入口）
VIEWER_PASSWORD=

# ---------- GitHub 仓库（服务端提交用） ----------
GITHUB_OWNER=your-github-name
GITHUB_REPO=board-hub
GITHUB_BRANCH=main

# ---------- GitHub App（服务端提交用，管理员发布/编辑/删除必需） ----------
# App 必须安装到上面的仓库，权限只要 Contents: Read and write
GITHUB_APP_ID=
# 私钥 .pem 全文。Vercel 输入框可直接粘贴多行文本；
# 若用单行环境变量，把换行写成 \n 也行（服务端会自动还原）
GITHUB_APP_PRIVATE_KEY=

# ---------- 站点标识（页面展示用） ----------
NEXT_PUBLIC_GITHUB_OWNER=your-github-name
NEXT_PUBLIC_GITHUB_REPO=board-hub
NEXT_PUBLIC_GITHUB_BRANCH=main
NEXT_PUBLIC_SITE_URL=https://board-hub.vercel.app
SITE_URL=https://board-hub.vercel.app
