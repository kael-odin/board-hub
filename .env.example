# Board Hub 环境变量
# 本地开发可以复制成 .env.local；线上在 Vercel 项目设置里配置

# ---------- GitHub 仓库 ----------
NEXT_PUBLIC_GITHUB_OWNER=your-github-name
NEXT_PUBLIC_GITHUB_REPO=board-hub
NEXT_PUBLIC_GITHUB_BRANCH=main

# ---------- GitHub App ----------
# App 必须安装到上面这个仓库，否则提交时会 404
NEXT_PUBLIC_GITHUB_APP_ID=

# 用于加密浏览器 sessionStorage 里缓存的私钥。
# 随便一串随机字符即可，它不是 GitHub 的密钥。
# 换掉它只会让已缓存的私钥失效，重新导入 .pem 就行。
NEXT_PUBLIC_GITHUB_ENCRYPT_KEY=change-me-to-a-random-string

# ---------- 站点地址 ----------
NEXT_PUBLIC_SITE_URL=https://board-hub.vercel.app
SITE_URL=https://board-hub.vercel.app

# ---------- 可选 ----------
# NEXT_PUBLIC_GA_ID=
